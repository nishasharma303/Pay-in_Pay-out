# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database (Neon free tier: https://neon.tech) ─────────────────────────────
DATABASE_URL=""YOUR SQL DATABASE CONNECTION STRING HERE""

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_this_to_a_random_64_byte_hex_string
JWT_REFRESH_SECRET=change_this_to_another_random_64_byte_hex_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Client ───────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000

# ─── Razorpay (Pay-In) — get from https://razorpay.com (test mode free) ───────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ─── Cashfree (Pay-Out) — get from https://cashfree.com (sandbox free) ────────
CASHFREE_APP_ID=your_app_id
CASHFREE_SECRET_KEY=your_secret_key
CASHFREE_ENV=TEST

# ─── Cloudinary (free tier: https://cloudinary.com) ───────────────────────────
# Leave empty to use local file storage in development
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Razorpay (Pay-In) — https://razorpay.com → Settings → API Keys ───────────
# Use TEST mode keys — free, no real money
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Webhook secret — set in Razorpay Dashboard → Webhooks → your endpoint → Show Secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ─── Cashfree (Pay-Out) — https://cashfree.com → Developers → Credentials ─────
# Use TEST/sandbox mode — free, no real money
CASHFREE_APP_ID=your_app_id_here
CASHFREE_SECRET_KEY=your_secret_key_here
# PROD or TEST
CASHFREE_ENV=TEST
