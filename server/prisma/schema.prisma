generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  CLIENT
  AGENT
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  PAY_IN
  PAY_OUT
  WALLET_TRANSFER
  COMMISSION
  REFUND
  CHARGE
}

enum TransactionStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

enum PayoutMode {
  IMPS
  NEFT
  UPI
}

// ─── User & Auth ──────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique @db.VarChar(255)
  phone        String?  @unique @db.VarChar(20)
  name         String   @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  role         Role     @default(AGENT)
  isActive     Boolean  @default(true)
  isVerified   Boolean  @default(false)

  // Hierarchy: tracks who created this user
  parentId     String?
  parent       User?    @relation("UserHierarchy", fields: [parentId], references: [id])
  children     User[]   @relation("UserHierarchy")

  // Relations
  wallet       Wallet?
  kyc          KycDetail?
  refreshTokens RefreshToken[]
  transactions  Transaction[] @relation("UserTransactions")
  commissionsEarned Commission[] @relation("CommissionRecipient")

  createdAt    DateTime @default(now()) @db.Timestamp(0)
  updatedAt    DateTime @updatedAt @db.Timestamp(0)

  @@index([role])
  @@index([parentId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(500)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamp(0)
  createdAt DateTime @default(now()) @db.Timestamp(0)

  @@index([userId])
}

// ─── KYC ──────────────────────────────────────────────────────────────────────

model KycDetail {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  panNumber      String?   @db.VarChar(20)
  aadhaarNumber  String?   @db.VarChar(20)   // Store masked: XXXX-XXXX-1234
  bankName       String?   @db.VarChar(100)
  accountNumber  String?   @db.VarChar(50)   // Store encrypted in production
  ifscCode       String?   @db.VarChar(20)
  accountHolder  String?   @db.VarChar(255)

  // Document image paths (store S3/Cloudinary URLs)
  panImageUrl    String?   @db.VarChar(500)
  aadhaarFrontUrl String?  @db.VarChar(500)
  aadhaarBackUrl String?   @db.VarChar(500)
  selfieUrl      String?   @db.VarChar(500)

  status         KycStatus @default(PENDING)
  reviewNote     String?   @db.Text
  reviewedAt     DateTime? @db.Timestamp(0)
  reviewedById   String?

  createdAt      DateTime  @default(now()) @db.Timestamp(0)
  updatedAt      DateTime  @updatedAt @db.Timestamp(0)
}

// ─── Wallet & Ledger ──────────────────────────────────────────────────────────

model Wallet {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Balances in paise (smallest unit) to avoid floating point issues
  // Always divide by 100 when displaying
  primaryBalance   BigInt   @default(0)   // Main spendable balance
  secondaryBalance BigInt   @default(0)   // Loaded but not yet transferred
  holdBalance      BigInt   @default(0)   // Frozen for pending transactions

  ledgerEntries    LedgerEntry[]

  createdAt        DateTime @default(now()) @db.Timestamp(0)
  updatedAt        DateTime @updatedAt @db.Timestamp(0)
}

model LedgerEntry {
  id              String          @id @default(cuid())
  walletId        String
  wallet          Wallet          @relation(fields: [walletId], references: [id])

  type            LedgerEntryType
  amount          BigInt          // In paise
  balanceAfter    BigInt          // Running balance after this entry (in paise)

  description     String          @db.Text
  referenceId     String?         @db.VarChar(255)  // Transaction ID or external ref
  transactionId   String?
  transaction     Transaction?    @relation(fields: [transactionId], references: [id])

  metadata        Json?           // Extra data (biller name, etc.)
  createdAt       DateTime        @default(now()) @db.Timestamp(0)

  @@index([walletId])
  @@index([referenceId])
  @@index([createdAt])
}

// ─── Transactions ─────────────────────────────────────────────────────────────

model Transaction {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation("UserTransactions", fields: [userId], references: [id])

  type            TransactionType
  status          TransactionStatus @default(INITIATED)

  amount          BigInt            // In paise
  fee             BigInt            @default(0)
  netAmount       BigInt            // amount - fee

  // External references
  gatewayOrderId  String?           @db.VarChar(255)  // Razorpay order ID / Cashfree order ID
  gatewayPaymentId String?          @db.VarChar(255)  // Razorpay payment ID
  gatewayRef      String?           @db.VarChar(255)  // Any gateway reference

  // Payout specific
  payoutMode      PayoutMode?
  beneficiaryName String?           @db.VarChar(255)
  accountNumber   String?           @db.VarChar(50)
  ifscCode        String?           @db.VarChar(20)
  upiId           String?           @db.VarChar(100)

  // Webhook idempotency
  webhookEventId  String?           @unique @db.VarChar(255)

  description     String?           @db.Text
  failureReason   String?           @db.Text
  metadata        Json?

  ledgerEntries   LedgerEntry[]
  commissions     Commission[]

  createdAt       DateTime          @default(now()) @db.Timestamp(0)
  updatedAt       DateTime          @updatedAt @db.Timestamp(0)

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([gatewayOrderId])
  @@index([createdAt])
}

// ─── Commissions ──────────────────────────────────────────────────────────────

model CommissionRule {
  id            String   @id @default(cuid())
  role          Role     // Who earns this commission
  serviceType   String   @db.VarChar(100)   // e.g. "AEPS", "BBPS", "DMT"
  isPercentage  Boolean  @default(true)
  value         Float    // e.g. 0.5 for 0.5% or 5 for flat ₹5
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now()) @db.Timestamp(0)
  updatedAt     DateTime @updatedAt @db.Timestamp(0)

  @@unique([role, serviceType])
}

model Commission {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  recipientId   String
  recipient     User        @relation("CommissionRecipient", fields: [recipientId], references: [id])

  role          Role
  amount        BigInt      // In paise
  isSettled     Boolean     @default(false)
  settledAt     DateTime?   @db.Timestamp(0)

  createdAt     DateTime    @default(now()) @db.Timestamp(0)

  @@index([transactionId])
  @@index([recipientId])
}

// ─── Audit Logs ───────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @db.VarChar(255)
  action     String   @db.VarChar(255)   // e.g. "USER_LOGIN", "KYC_APPROVED", "WALLET_CREDITED"
  entity     String?  @db.VarChar(100)   // e.g. "User", "Transaction"
  entityId   String?  @db.VarChar(255)
  ipAddress  String?  @db.VarChar(50)
  userAgent  String?  @db.Text
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamp(0)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ─── Payments ──────────────────────────────────────────────────────────────

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

enum PaymentFor {
  PLAN_SUBSCRIPTION
  COURSE_ENROLLMENT
}

model Payment {
  id                String        @id @default(cuid())
  razorpayOrderId   String        @unique @db.VarChar(255)
  razorpayPaymentId String?       @db.VarChar(255)
  razorpaySignature String?       @db.Text
  amount            Float
  currency          String        @default("INR") @db.VarChar(10)
  status            PaymentStatus @default(PENDING)
  paymentFor        PaymentFor
  
  instituteId       String        @db.VarChar(255)
  userId            String        @db.VarChar(255)
  courseId          String?       @db.VarChar(255)
  planType          PlanType?
  
  createdAt         DateTime      @default(now()) @db.Timestamp(0)
  updatedAt         DateTime      @updatedAt @db.Timestamp(0)

  @@index([userId])
  @@index([instituteId])
  @@index([razorpayOrderId])
}

enum PlanType {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}